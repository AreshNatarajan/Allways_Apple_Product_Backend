    {
      "name": "3. Vendor Read",
      "item": [
        {
          "name": "Get Vendor by ID",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 200', function () { pm.response.to.have.status(200); });" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/{{vendorId}}", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "{{vendorId}}" ] }
          }
        },
        {
          "name": "Get Vendor by invalid ID format",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 400', function () { pm.response.to.have.status(400); });" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/not-a-valid-id", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "not-a-valid-id" ] }
          }
        },
        {
          "name": "Get Vendor by well-formed but nonexistent ID",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 404', function () { pm.response.to.have.status(404); });" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/000000000000000000000000", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "000000000000000000000000" ] }
          }
        },
        {
          "name": "List Vendors (paginated, default active only)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Has pagination block', function () { pm.expect(pm.response.json().data).to.have.property('pagination'); });" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/list?page=1&limit=10", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "list" ], "query": [ { "key": "page", "value": "1" }, { "key": "limit", "value": "10" } ] }
          }
        },
        {
          "name": "Search vendors",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/list?search=ABC", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "list" ], "query": [ { "key": "search", "value": "ABC" } ] }
          }
        },
        {
          "name": "Filter: Active only",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/list?isActive=true", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "list" ], "query": [ { "key": "isActive", "value": "true" } ] }
          }
        },
        {
          "name": "Filter: Inactive only",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/list?isActive=false", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "list" ], "query": [ { "key": "isActive", "value": "false" } ] }
          }
        },
        {
          "name": "Filter: Include inactive (all)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/list?includeInactive=true", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "list" ], "query": [ { "key": "includeInactive", "value": "true" } ] }
          }
