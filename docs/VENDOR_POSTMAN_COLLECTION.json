            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Different Name 3\",\n  \"vendorCode\": \"VEND001\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/vendor/create", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "create" ] }
          }
        },
        {
          "name": "Attempt to provide branchId (silently ignored, not an error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 - vendor still created', function () { pm.response.to.have.status(201); });",
                  "pm.test('branchId is not on the created vendor', function () {",
                  "    pm.expect(pm.response.json().data).to.not.have.property('branchId');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Vendor Branch Attempt\",\n  \"branchId\": \"64f000000000000000000000\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/vendor/create", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "create" ] },
            "description": "Vendor is a global master and the schema has no branchId field at all - any branchId sent by the client is simply never read or stored."
          }
        },
