            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"hacked\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/vendor/update/{{vendorId}}", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "update", "{{vendorId}}" ] }
          }
        }
      ]
    },
    {
      "name": "5. Vendor Deactivate / Reactivate",
      "item": [
        {
          "name": "Deactivate (soft-delete) Vendor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('isDeleted true, isActive false', function () {",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.isDeleted).to.eql(true);",
                  "    pm.expect(data.isActive).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/delete/{{vendorId}}", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "delete", "{{vendorId}}" ] }
          }
        },
        {
          "name": "Deactivated vendor still viewable by ID",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 200 - still viewable', function () { pm.response.to.have.status(200); });" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/{{vendorId}}", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "{{vendorId}}" ] }
          }
        },
        {
          "name": "Deactivated vendor excluded from default list",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/list?search=ABC Medical", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "list" ], "query": [ { "key": "search", "value": "ABC Medical" } ] }
          }
        },
        {
          "name": "Reactivate Vendor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('isDeleted false, isActive true', function () {",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.isDeleted).to.eql(false);",
                  "    pm.expect(data.isActive).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/{{vendorId}}/reactivate", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "{{vendorId}}", "reactivate" ] }
          }
        },
        {
          "name": "Reactivate already-active vendor (400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 400', function () { pm.response.to.have.status(400); });" ] } }
          ],
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/{{vendorId}}/reactivate", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "{{vendorId}}", "reactivate" ] }
          }
        },
        {
          "name": "Forbidden: STAFF cannot deactivate/reactivate",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 403', function () { pm.response.to.have.status(403); });" ] } }
          ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{staffToken}}" } ],
            "url": { "raw": "{{baseUrl}}/vendor/delete/{{vendorId}}", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "delete", "{{vendorId}}" ] }
          }
        }
