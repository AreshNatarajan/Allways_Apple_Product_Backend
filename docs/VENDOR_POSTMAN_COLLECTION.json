{
  "info": {
    "_postman_id": "d4b2e7a1-3c5f-4a8e-9d1b-vendormaster",
    "name": "Vendor Master (Dev)",
    "description": "Covers only the Vendor Master backend endpoints. Vendor is a GLOBAL master - it never belongs to a branchId, and any branch/role may read it per the roles below. Run folders top to bottom - later requests depend on variables set by earlier ones (tokens, ids). Does not touch Product/Purchase/Sale/Inventory/Batch/Serial/Transfer/Branch/User endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "superAdminEmail", "value": "superadmin@test.com" },
    { "key": "superAdminPassword", "value": "Test@12345" },
    { "key": "branchAdminEmail", "value": "branchadmin@test.com" },
    { "key": "branchAdminPassword", "value": "Test@12345" },
    { "key": "staffEmail", "value": "staff@test.com" },
    { "key": "staffPassword", "value": "Test@12345" },
    { "key": "superAdminToken", "value": "" },
    { "key": "branchAdminToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "vendorId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login SUPER_ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('superAdminToken', pm.response.json().data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        },
        {
          "name": "Login BRANCH_ADMIN (for negative authorization tests)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "if (pm.response.code === 200) { pm.collectionVariables.set('branchAdminToken', pm.response.json().data.token); }" ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{branchAdminEmail}}\",\n  \"password\": \"{{branchAdminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        },
        {
          "name": "Login STAFF (for negative authorization tests)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "if (pm.response.code === 200) { pm.collectionVariables.set('staffToken', pm.response.json().data.token); }" ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        }
      ]
    },
    {
      "name": "2. Vendor Create",
      "item": [
        {
          "name": "Create Vendor (valid, full fields)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json().data;",
                  "    pm.collectionVariables.set('vendorId', data._id);",
                  "    pm.test('No branchId on the vendor (global master)', function () {",
                  "        pm.expect(data).to.not.have.property('branchId');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ABC Medical Supplies\",\n  \"companyName\": \"ABC Medical Supplies Pvt Ltd\",\n  \"email\": \"vendor.test@example.com\",\n  \"phone\": \"9876543210\",\n  \"alternatePhone\": \"9876500000\",\n  \"address\": \"123 Main Road\",\n  \"city\": \"Chennai\",\n  \"state\": \"Tamil Nadu\",\n  \"country\": \"India\",\n  \"pincode\": \"600001\",\n  \"vendorCode\": \"VEND001\",\n  \"gstNumber\": \"33ABCDE1234F1Z5\",\n  \"panNumber\": \"ABCDE1234F\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/vendor/create", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "create" ] }
          }
        },
        {
          "name": "Invalid: Missing name",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 400', function () { pm.response.to.have.status(400); });" ] } }
