          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876543210\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/vendor/create", "host": [ "{{baseUrl}}" ], "path": [ "vendor", "create" ] }
          }
        },
