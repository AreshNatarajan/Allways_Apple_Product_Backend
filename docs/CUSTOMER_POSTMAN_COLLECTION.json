          }
        }
      ]
    },
    {
      "name": "5. Soft Delete / Reactivate",
      "item": [
        {
          "name": "Deactivate",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json().data;",
              "pm.test('isActive false, isDeleted true', function () { pm.expect(data.isActive).to.eql(false); pm.expect(data.isDeleted).to.eql(true); });"
            ] } }
          ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{branchAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/customer/delete/{{customerId}}", "host": [ "{{baseUrl}}" ], "path": [ "customer", "delete", "{{customerId}}" ] }
          }
        },
        {
          "name": "Reactivate",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json().data;",
              "pm.test('isActive true, isDeleted false', function () { pm.expect(data.isActive).to.eql(true); pm.expect(data.isDeleted).to.eql(false); });"
            ] } }
          ],
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{branchAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/customer/{{customerId}}/reactivate", "host": [ "{{baseUrl}}" ], "path": [ "customer", "{{customerId}}", "reactivate" ] }
          }
        },
        {
          "name": "Reactivate already-active customer (negative)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 400', function () { pm.response.to.have.status(400); });" ] } } ],
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{branchAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/customer/{{customerId}}/reactivate", "host": [ "{{baseUrl}}" ], "path": [ "customer", "{{customerId}}", "reactivate" ] }
          }
        }
      ]
    },
    {
      "name": "6. Branch Isolation & Authorization",
      "item": [
        {
          "name": "Cross-branch GET denied (STAFF, customerId2 now in branchId2)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 404', function () { pm.response.to.have.status(404); });" ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{staffToken}}" } ],
            "url": { "raw": "{{baseUrl}}/customer/{{customerId2}}", "host": [ "{{baseUrl}}" ], "path": [ "customer", "{{customerId2}}" ] }
          }
        },
        {
          "name": "Cross-branch UPDATE denied (BRANCH_ADMIN)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 404', function () { pm.response.to.have.status(404); });" ] } } ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{branchAdminToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"should not apply\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/customer/update/{{customerId2}}", "host": [ "{{baseUrl}}" ], "path": [ "customer", "update", "{{customerId2}}" ] }
          }
        },
        {
          "name": "SUPER_ADMIN unrestricted GET (any branch)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 200', function () { pm.response.to.have.status(200); });" ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{superAdminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/customer/{{customerId2}}", "host": [ "{{baseUrl}}" ], "path": [ "customer", "{{customerId2}}" ] }
          }
        },
        {
          "name": "No token",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 401', function () { pm.response.to.have.status(401); });" ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/customer/list", "host": [ "{{baseUrl}}" ], "path": [ "customer", "list" ] }
          }
        },
        {
          "name": "Invalid/expired token",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status is 401', function () { pm.response.to.have.status(401); });" ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer invalid.token.here" } ],
            "url": { "raw": "{{baseUrl}}/customer/list", "host": [ "{{baseUrl}}" ], "path": [ "customer", "list" ] }
          }
        }
      ]
    }
